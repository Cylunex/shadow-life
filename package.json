{
  "name": "shadow-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "dev": "pnpm --parallel --filter @shadow/api --filter @shadow/web dev",
    "db:migrate": "node --import tsx server/database/src/migrate.ts",
    "build": "pnpm -r --if-present build",
    "check": "pnpm check:contracts && pnpm check:boundaries && pnpm check:android-boundaries && pnpm -r --if-present typecheck && pnpm -r --if-present test",
    "check:contracts": "pnpm --filter @shadow/contracts check-generated",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:android-boundaries": "node scripts/check-android-modules.mjs",
    "test:journey": "node scripts/test-journey.mjs",
    "test:health-ledger": "node scripts/test-journey.mjs health-ledger",
    "test:full:offline": "node scripts/test-offline-full.mjs",
    "test:full": "node scripts/test-full.mjs",
    "test:foundation:offline": "node scripts/test-foundation-offline.mjs",
    "test:android-health": "node scripts/test-health-policy.mjs",
    "eval:agent:model": "node scripts/eval-agent-model.mjs",
    "eval:agent:offline": "node scripts/eval-agent-offline.mjs",
    "eval:agent": "node scripts/eval-agent.mjs",
    "mcp": "pnpm --filter @shadow/mcp start",
    "catalog:diff": "node --import tsx scripts/agent-catalog.ts",
    "import:dry-run": "pnpm --filter @shadow/legacy-importer dry-run",
    "migration": "pnpm --filter @shadow/legacy-importer migration",
    "migration:mapping": "pnpm --filter @shadow/legacy-importer mapping",
    "test:workout:offline": "node --import tsx scripts/test-workout-menu-offline.mjs",
    "test:web:offline": "node --import tsx scripts/test-web-snapshots-offline.mjs",
    "test:wellness:offline": "node --import tsx scripts/test-wellness-offline.mjs",
    "test:daily:web:offline": "node --import tsx scripts/test-daily-workspaces-offline.mjs",
    "dev:server": "pnpm --filter @shadow/api dev",
    "dev:client": "pnpm --filter @shadow/web dev",
    "dev:worker": "pnpm --filter @shadow/worker start",
    "build:client": "pnpm --filter @shadow/web build",
    "check:shared": "pnpm --filter @shadow/contracts check-generated:shared && pnpm --filter @shadow/contracts typecheck && pnpm --filter @shadow/contracts test",
    "check:server": "pnpm --filter @shadow/contracts check-generated:shared && pnpm check:boundaries && pnpm -r --filter \"./server/**\" --filter @shadow/contracts --if-present typecheck && pnpm test:server",
    "check:client": "pnpm check:contracts && pnpm check:boundaries && pnpm check:android-boundaries && pnpm -r --filter \"./client/**\" --filter @shadow/contracts --if-present typecheck && pnpm test:client",
    "test:server": "node scripts/test-full.mjs --scope server",
    "test:client": "node scripts/test-full.mjs --scope client",
    "test:server:offline": "node scripts/test-offline-full.mjs --scope server",
    "start:server": "pnpm --filter @shadow/api start",
    "start:worker": "pnpm --filter @shadow/worker start"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "playwright": "1.62.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
