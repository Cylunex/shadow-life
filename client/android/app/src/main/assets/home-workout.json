  "exercises": [
    {
      "id": "wall_pushup",
      "name": "墙面俯卧撑",
      "focus": "chest",
      "equipment": "bodyweight",
      "difficulty": "easy",
      "unit": "reps",
      "guidance": "双手扶墙，身体保持一条线，胸靠近墙再推回。",
      "caution": "墙面和脚下防滑；肩部不适时缩小幅度。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "incline_pushup",
      "name": "高位俯卧撑",
      "focus": "chest",
      "equipment": "bodyweight",
      "difficulty": "easy",
      "unit": "reps",
      "guidance": "双手撑牢固台面，收住腰腹，胸向台面下降。",
      "caution": "只用不会滑动、翻倒的台面。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "knee_pushup",
      "name": "跪姿俯卧撑",
      "focus": "chest",
      "equipment": "bodyweight",
      "difficulty": "easy",
      "unit": "reps",
      "guidance": "膝盖垫软垫，膝到肩保持直线，肘向斜后方弯。",
      "caution": "不要塌腰或把肘完全向两侧打开。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "pushup",
      "name": "标准俯卧撑",
      "focus": "chest",
      "equipment": "bodyweight",
      "difficulty": "moderate",
      "unit": "reps",
      "guidance": "身体整体下降和推起，保持肩、髋、脚踝成线。",
      "caution": "塌腰或耸肩时退回高位版本。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "pause_pushup",
      "name": "底部停顿俯卧撑",
      "focus": "chest",
      "equipment": "bodyweight",
      "difficulty": "challenging",
      "unit": "reps",
      "guidance": "标准俯卧撑底部短暂停顿，再平稳推起。",
      "caution": "先掌握标准版；不追求贴地或力竭。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "slow_pushup",
      "name": "慢下放俯卧撑",
      "focus": "chest",
      "equipment": "bodyweight",
      "difficulty": "challenging",
      "unit": "reps",
      "guidance": "用约三秒下降，保持身体稳定再推回。",
      "caution": "难度来自控制；腰部失稳时结束。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "floor_press",
      "name": "哑铃地板卧推",
      "focus": "chest",
      "equipment": "dumbbell",
      "difficulty": "easy",
      "unit": "reps",
      "guidance": "屈膝仰卧，上臂轻触地板后推起，前臂大致竖直。",
      "caution": "哑铃先放腿旁再就位，避免砸地反弹。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "neutral_press",
      "name": "对握地板卧推",
      "focus": "chest",
      "equipment": "dumbbell",
      "difficulty": "easy",
      "unit": "reps",
      "guidance": "掌心相对，肘靠身体一些，在地板上平稳推举。",
      "caution": "用肩关节舒适的肘角度，不锁死肘。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "squeeze_press",
      "name": "哑铃挤压卧推",
      "focus": "chest",
      "equipment": "dumbbell",
      "difficulty": "moderate",
      "unit": "reps",
      "guidance": "地板仰卧，两只哑铃靠拢，轻轻向内夹并推起。",
      "caution": "哑铃接触面须稳定；手腕保持直线。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "floor_fly",
      "name": "哑铃地板飞鸟",
      "focus": "chest",
      "equipment": "dumbbell",
      "difficulty": "moderate",
      "unit": "reps",
      "guidance": "仰卧屈膝，肘微弯，双臂沿弧线打开再合拢。",
      "caution": "比卧推用更轻重量；上臂触地即止，肩痛就停。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "heel_slide",
      "name": "仰卧脚跟滑动",
      "focus": "core",
      "equipment": "bodyweight",
      "difficulty": "easy",
      "unit": "reps",
      "guidance": "屈膝仰卧，一只脚跟缓慢滑远再收回，交替进行。",
      "caution": "保持自然腰位与呼吸；腰开始拱起前收回。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "dead_bug_arms",
      "name": "仰卧交替抬臂",
      "focus": "core",
      "equipment": "bodyweight",
      "difficulty": "easy",
      "unit": "reps",
      "guidance": "双脚踩地、手臂向上，一侧手臂缓慢向头顶放低再回。",
      "caution": "以腰背不拱起的幅度为限。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "dead_bug",
      "name": "死虫式",
      "focus": "core",
      "equipment": "bodyweight",
      "difficulty": "moderate",
      "unit": "reps",
      "guidance": "仰卧抬腿屈膝，对侧手脚缓慢伸远，再交替。",
      "caution": "伸展越远越难；先单动腿，别憋气或顶腰。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "bird_dog",
      "name": "鸟狗式",
      "focus": "core",
      "equipment": "bodyweight",
      "difficulty": "easy",
      "unit": "reps",
      "guidance": "四点支撑，对侧手脚向远处伸直，骨盆保持水平。",
      "caution": "先只伸一条腿；不抬高到腰部反弓。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "knee_plank",
      "name": "跪姿平板支撑",
      "focus": "core",
      "equipment": "bodyweight",
      "difficulty": "easy",
      "unit": "seconds",
      "guidance": "前臂和膝盖支撑，收住腰腹，保持正常呼吸。",
      "caution": "腰不舒服就缩短时间或换仰卧动作。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "plank",
      "name": "前臂平板支撑",
      "focus": "core",
      "equipment": "bodyweight",
      "difficulty": "moderate",
      "unit": "seconds",
      "guidance": "前臂与脚尖支撑，身体保持一线，均匀呼吸。",
      "caution": "不塌腰，不用长时间硬撑来升级。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "knee_side_plank",
      "name": "屈膝侧桥",
      "focus": "core",
      "equipment": "bodyweight",
      "difficulty": "easy",
      "unit": "seconds",
      "guidance": "侧卧屈膝，肘在肩下，抬髋使肩髋膝成线。",
      "caution": "左右分别练；肩或腰不适则停止。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
      "id": "side_plank",
      "name": "直腿侧桥",
      "focus": "core",
      "equipment": "bodyweight",
      "difficulty": "challenging",
      "unit": "seconds",
      "guidance": "前臂和脚侧支撑，抬髋保持身体侧面一线。",
      "caution": "先能稳定完成屈膝版；不转腰、不憋气。",
      "source_url": "https://www.acefitness.org/resources/everyone/exercise-library/"
    },
    {
