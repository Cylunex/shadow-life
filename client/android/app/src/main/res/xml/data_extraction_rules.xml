<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup disableIfNoEncryptionCapabilities="true">
    <exclude domain="database" path="." />
    <exclude domain="file" path="pending-assets/" />
    <exclude domain="sharedpref" path="shadow_sessions.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="database" path="." />
    <exclude domain="file" path="pending-assets/" />
    <exclude domain="sharedpref" path="shadow_sessions.xml" />
  </device-transfer>
</data-extraction-rules>
