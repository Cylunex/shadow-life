        "path": "/api/health/route-comparison",
        "rows": "items",
        "pick": {
          "workout_id": "id",
          "expected_revision": "revision",
          "route": "route",
          "duration_basis": "duration_basis"
        }
      },
      {
        "title": "保存路线标记",
        "cap": "health.set_workout_route",
        "fields": [
          {
            "key": "workout_id",
            "label": "运动记录",
            "type": "id"
          },
          {
            "key": "route",
            "label": "路线名称",
            "type": "text"
          },
          {
            "key": "duration_basis",
            "label": "用时口径",
            "type": "choice",
            "initial": "unknown",
            "choices": {
              "unknown": "未知",
              "elapsed": "总用时",
              "moving": "移动用时"
            }
          },
          {
            "key": "expected_revision",
            "label": "当前版本",
            "type": "int"
          }
        ]
      },
      {
        "title": "晚间训练后的睡眠",
        "cap": "health.evening_sleep",
        "fields": [
          {
            "key": "from",
            "label": "开始日期",
            "type": "date",
            "initial": "week"
          },
          {
            "key": "to",
            "label": "结束日期",
            "type": "date",
            "initial": "today"
          },
          {
            "key": "time_zone",
            "label": "时区",
            "type": "zone",
            "initial": "zone"
          }
        ],
        "path": "/api/health/evening-sleep",
        "rows": "days",
        "pick": {
          "occurred_on": "date",
          "expected_revision": "rest_revision",
          "is_rest": "is_rest"
        }
      },
      {
        "title": "记录休息日",
        "cap": "health.set_rest_day",
