[
  {
    "title": "路线与训练复盘",
    "actions": [
      {
        "title": "选运动记录",
        "cap": "health.records",
        "fields": [],
        "path": "/api/health",
        "rows": "items",
        "pick": {
          "workout_id": "id"
        }
      },
      {
        "title": "查看路线",
        "cap": "health.route_comparison",
        "fields": [
          {
            "key": "route",
            "label": "路线名称",
            "type": "text"
          },
          {
            "key": "session_type",
            "label": "运动类型",
            "type": "text"
          },
          {
            "key": "duration_basis",
            "label": "用时口径",
            "type": "choice",
            "choices": {
              "elapsed": "总用时",
              "moving": "移动用时",
              "unknown": "未知"
            }
          }
        ],
        "path": "/api/health/route-comparison",
        "rows": "items",
        "pick": {
          "workout_id": "id",
          "expected_revision": "revision",
          "route": "route",
          "duration_basis": "duration_basis"
        }
      },
      {
        "title": "读取运动标记",
        "cap": "health.route_comparison",
