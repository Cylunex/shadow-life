DATABASE_URL=postgresql://shadow:REPLACE_PASSWORD@127.0.0.1:5432/shadow_life
SHADOW_DEV_AUTH=false
SHADOW_API_URL=http://127.0.0.1:8787
# Production Web login (values are deployment-specific and stay outside Git).
SHADOW_OIDC_ISSUER=https://id.example.com/
SHADOW_OIDC_AUDIENCE=shadow-life
SHADOW_OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json
SHADOW_OIDC_AUTHORIZATION_URL=https://id.example.com/authorize
SHADOW_OIDC_TOKEN_URL=https://id.example.com/oauth/token
SHADOW_OIDC_CLIENT_ID=REPLACE_CLIENT_ID
SHADOW_OIDC_REDIRECT_URI=https://life.example.com/auth/callback
SHADOW_WEB_ORIGIN=https://life.example.com
SHADOW_SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_VALUE
# Optional NDJSON Agent Runtime gateway. Token stays in local runtime configuration.
SHADOW_RUNTIME_URL=https://example.com/shadow-runtime
SHADOW_RUNTIME_TOKEN=REPLACE_RUNTIME_TOKEN
# Development only: SHADOW_ACCESS_TOKEN=dev:subject_example
